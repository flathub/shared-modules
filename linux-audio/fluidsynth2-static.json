{
  "name": "fluidsynth",
  "buildsystem": "cmake-ninja",
  "build-options": {
    "cflags": "-fPIC",
    "cxxflags": "-fPIC"
  },
  "config-opts": [
    "-DBUILD_SHARED_LIBS=OFF",
    "-Denable-jack=OFF",
    "-Denable-pipewire=OFF",
    "-Denable-sdl3=OFF"
